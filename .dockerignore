.github
.kilo
.pytest_cache
.ruff_cache
.pnpm-store
node_modules
**/node_modules
.venv
**/.venv
**/__pycache__
**/*.pyc

data/processed
data/interim
data/external
data/dev_fixtures
ml/reports
ml/artifacts
ml/notebooks

# The API resolves district weather coordinates from the checked-in Rwanda
# boundary file. Keep the rest of the web application out of the API image,
# but allow this small runtime GIS asset through.
apps
!apps/
!apps/web/
!apps/web/public/
!apps/web/public/geodata/
!apps/web/public/geodata/rwanda_districts.geojson
VISUAL IMAGE
.DS_Store
**/.DS_Store
*.log
.env
