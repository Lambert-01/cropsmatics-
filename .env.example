# Cropmatics Rwanda — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Secrets: in production load these from your platform secret store
# (Render/Fly/Neon/Supabase/Vercel env vars), not from a file in the repo.

# ---- Core ----
ENVIRONMENT=development
LOG_LEVEL=info

# ---- Database (PostgreSQL + PostGIS) ----
DATABASE_URL=postgresql+psycopg://cropmatics:cropmatics@localhost:5432/cropmatics

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- CORS (comma-separated origins) ----
CORS_ORIGINS=http://localhost:3000

# ---- Data paths (relative to repo root) ----
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ---- Mobile (Expo) ----
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
