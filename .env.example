# Cropmatics Rwanda — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Secrets: in production load these from your platform secret store
# (Render/Fly/Neon/Supabase/Vercel env vars), not from a file in the repo.

# ---- Core ----
ENVIRONMENT=development
LOG_LEVEL=info

# ---- Database (PostgreSQL + PostGIS) ----
DATABASE_URL=postgresql+psycopg://cropmatics:cropmatics@localhost:5432/cropmatics
#
# Which layer answers the analytical reads.
#   required  - PostgreSQL must be ready; readiness fails and analytical reads
#               return DATABASE_UNAVAILABLE rather than serving processed files.
#   preferred - PostgreSQL first, explicit fallback to the processed files.
#   file      - processed files only (development/testing).
# Unset means `required` in production and `preferred` everywhere else, so a
# production deploy cannot quietly serve CSV artefacts as canonical data.
CANONICAL_DATA_MODE=

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- CORS (comma-separated origins) ----
CORS_ORIGINS=http://localhost:3000

# ---- Data paths (relative to repo root) ----
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Public builds require an HTTPS API URL. For intentional local `next build` testing:
# CROPMATICS_LOCAL_PREVIEW=1

# ---- Mobile (Expo) ----
# A physical device cannot reach `localhost` — use the machine's LAN IP, e.g.
# http://192.168.x.x:8000/api/v1 (never commit a real LAN IP).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Field Operations (legacy harvest tools) are hidden from the primary nav unless
# this is explicitly true.
EXPO_PUBLIC_ENABLE_FIELD_OPERATIONS=false

# ---- AI explanation layer (all OPTIONAL) ----
# Cropmatics answers every question without any of these. The deterministic
# grounded assistant is the fallback and the default: AI_ENABLED=false means the
# platform never needs a model provider. Enabling a provider only upgrades the
# *wording*; the numeric guard still rejects any figure the evidence cannot back.
#
# Secrets stay server-side. Never expose a provider key through NEXT_PUBLIC_* or
# EXPO_PUBLIC_* - web and mobile talk to this API, not to a model vendor.
AI_ENABLED=false
# Groq is the primary hosted provider when AI_ENABLED=true. The deterministic
# evidence answer remains the fallback and is used when this is false.
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
# Equivalent explicit Groq names are supported and are useful on Render.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
# Optional secondary provider. It is tried only after the primary fails or its
# output is rejected by grounding validation.
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
# Any OpenAI-compatible chat-completions endpoint remains supported. Set
# AI_PROVIDER=openai_responses for the official OpenAI Responses API instead.
# The two wire formats are parsed separately; no provider response is trusted
# until it passes Cropmatics evidence validation.
#
# OpenAI aliases remain accepted for existing deployments. Precedence when
# several are set: AI_* wins, then provider-specific aliases, then OPENAI_*.
# An alias supplies a value, but AI_ENABLED=true is still required.
#
# Groq example (server-side only; never use NEXT_PUBLIC_* or EXPO_PUBLIC_*):
# AI_ENABLED=true
# AI_PROVIDER=groq
# AI_MODEL=openai/gpt-oss-20b
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=<replacement Groq secret>
# Alternatively use GROQ_MODEL, GROQ_BASE_URL and GROQ_API_KEY directly.
#
# Both adapters append their route to AI_BASE_URL. For official OpenAI use:
# AI_BASE_URL=https://api.openai.com/v1
# AI_PROVIDER=openai_responses calls {base}/responses. Its optional sampling
# settings are omitted so models that do not accept temperature can be used.
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=700
AI_MAX_TOOL_CALLS=6
# Let the model choose and chain tools itself (the agent loop) rather than only
# rewriting pre-retrieved evidence. The numeric guard still rejects any figure a
# tool did not return, so this changes what is *retrieved*, not what may be said.
AI_AGENT_ENABLED=true
# Hard bound on model turns in the agent loop, independent of the tool budget.
AI_MAX_AGENT_STEPS=8
AI_RETRY_ATTEMPTS=2
AI_RETRY_BACKOFF_SECONDS=0.25
# Sliding-window limits per authenticated subject or anonymous client digest.
AI_RATE_LIMIT_REQUESTS=60
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_MAX_KEYS=10000
# Only enable when Render or another trusted reverse proxy is configured to
# provide X-Forwarded-For. It is false by default to avoid spoofed identities.
AI_TRUST_PROXY_HEADERS=false

# ---- App distribution (share / install) ----
# URL the mobile share screen QR encodes and the web QR encodes.
# The /install web page carries the QR + install instructions.
NEXT_PUBLIC_INSTALL_PAGE_URL=http://localhost:3000/install
# Public APK URL from the approved release host. Leave empty until an APK exists.
NEXT_PUBLIC_INSTALL_APK_URL=
# Same value, baked into mobile builds (see scripts/build-apk.sh).
EXPO_PUBLIC_INSTALL_PAGE_URL=http://localhost:3000/install
# Optional stable APK URL baked into the mobile share screen after publishing.
EXPO_PUBLIC_INSTALL_APK_URL=
