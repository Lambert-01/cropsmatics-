# pnpm's default symlinked/virtual store lives in <root>/node_modules/.pnpm,
# but Metro (Expo) resolves module paths relative to each app folder
# (apps/mobile). It therefore fails to resolve the expo-router entry point
# ("Unable to resolve module ./node_modules/.pnpm/expo-router@.../entry").
# `hoisted` makes pnpm build a flat, npm-style node_modules that Metro handles.
node-linker=hoisted
