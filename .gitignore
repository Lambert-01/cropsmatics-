__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# ---- Data hygiene: never commit heavyweight/build outputs ----
# Raw official sources ARE committed (small, and required for reproducibility).
# Interim and processed artefacts are generated by scripts/data and are NOT committed.
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
# Owner-provided NISR SAS workbooks stay local and untracked; their hashes are
# recorded by scripts/data/inventory_sas_workbooks.py. The curated 2025B
# official original was already versioned and remains versioned after its move.
data/*.xlsx
data/raw/nisr/sas/**/*.xlsx
!data/raw/nisr/sas/2025/season_b/workbooks/Tables_2025_Season_B_0_curated_official.xlsx
ml/artifacts/*
!ml/artifacts/.gitkeep
ml/reports/*
!ml/reports/.gitkeep
data/**/*.tmp

# ---- Local dev runner (scripts/dev.sh) ----
.dev-run/

# ---- Misc ----
*.log
.vercel
.env*
