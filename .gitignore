# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# ---- Secrets / env ----
.env
.env.*
!.env.example

# ---- Node ----
node_modules/
.pnpm-store/
.next/
out/
dist/
build/
*.tsbuildinfo
coverage/
.expo/
.expo-shared/
web-build/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# ---- Data hygiene: never commit heavyweight/build outputs ----
# Raw official sources ARE committed (small, and required for reproducibility).
# Processed artefacts are generated by scripts/data and are NOT committed.
data/interim/*
!data/interim/.gitkeep
# legacy official-derived extracts are kept for provenance
!data/interim/legacy_official_derived/
!data/interim/legacy_official_derived/**
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
ml/artifacts/*
!ml/artifacts/.gitkeep
ml/reports/*
!ml/reports/.gitkeep
data/**/*.tmp

# ---- Local dev runner (scripts/dev.sh) ----
.dev-run/

# ---- Misc ----
*.log
