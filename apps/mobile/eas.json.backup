{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "description": "Shareable Android APK — installs directly on any phone from a link, no Play Store needed. API URL is read from apps/mobile/.env (EXPO_PUBLIC_API_BASE_URL).",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "description": "Play Store build (.aab).",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
