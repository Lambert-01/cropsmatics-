{
  "expo": {
    "name": "Cropmatics",
    "slug": "cropmatics",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon-1024.png",
    "scheme": "cropmatics",
    "primaryColor": "#087F5B",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7FAF8",
    "splash": {
      "image": "./assets/branding/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#032D23",
      "dark": {
        "image": "./assets/branding/splash-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#032D23"
      }
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "./plugins/with-analytical-theme",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-logo.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#032D23"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cropmatics attaches a photo to a harvest you register. Photos stay on your device until you sync.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cropmatics can record where a harvest was made. Location is optional and is never published in public analytics."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cropmatics.rwanda",
      "icon": "./assets/branding/app-icon-1024.png"
    },
    "android": {
      "package": "com.cropmatics.rwanda",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon-foreground.png",
        "backgroundColor": "#032D23",
        "monochromeImage": "./assets/branding/android-monochrome-icon.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d9c8f6a9-311a-4603-a27d-8bb633e00b70"
      }
    }
  }
}
