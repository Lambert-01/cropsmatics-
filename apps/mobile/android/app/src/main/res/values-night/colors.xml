<resources>
  <!--
    Night-scheme colours, generated by plugins/with-analytical-theme.js — do not
    edit by hand. Same names as res/values/colors.xml, so styles.xml never has to
    know which scheme is active.

    These values now actually apply. They did not before: the app pinned
    `userInterfaceStyle: "light"`, which put AppCompatDelegate in MODE_NIGHT_NO
    and left every file in this folder inert.
  -->
  <color name="app_background">#07140F</color>
  <color name="app_surface">#111C18</color>
  <color name="status_bar">#111C18</color>
  <color name="nav_bar">#111C18</color>
  <color name="app_text">#F1F5F9</color>

  <!--
    Deliberately the SAME brand green as the light scheme, not a light colour.
    The launch window is the branded splash, and the splash mark is a bright
    green on transparency — a light launch window here is exactly the white
    flash that dark mode must not have.
  -->
  <color name="splashscreen_background">#032D23</color>
</resources>
