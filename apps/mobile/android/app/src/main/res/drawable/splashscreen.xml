<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Native launch window.

  The launch window now shows the Cropmatics brand green (#032D23, matching
  expo.splash.backgroundColor in app.json) with the bright Cropmatics mark small
  and centred. The mark is a bright green on transparency, so dark green is the
  deliberate branded launch surface, not a flash. The app shell returns to its
  light neutral surface once the first React Native frame is reached.

  splashscreen_logo.png lives in drawable-nodpi so Android draws it at its
  intrinsic 320 px instead of scaling it to the density bucket, which keeps the
  mark a sane size on every screen without upscaling.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:drawable="@color/splashscreen_background"/>
  <item>
    <bitmap
      android:src="@drawable/splashscreen_logo"
      android:gravity="center"/>
  </item>
</layer-list>
