        },
        "scenario_period": "2025B",
        "top_n": 10
      },
      "request": {
        "baseline": {
          "weights": {
            "gap": 0.3,
            "vulnerability": 0.2,
            "affected_scale": 0.2,
            "readiness": 0.2,
