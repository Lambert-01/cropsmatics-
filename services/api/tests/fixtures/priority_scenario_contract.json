{
  "_comment": [
    "The request contract for POST /scenarios/priority, shared by both sides so a",
    "change on one side fails on the other.",
    "",
    "  * `apps/web/tests/priority-request.test.ts` feeds each `inputs` object to",
    "    `buildPriorityScenarioRequest` and requires the exact `request` body.",
    "  * `services/api/tests/test_priority_scenario.py` validates each `request`",
    "    against `PriorityScenarioRequest` and requires every `rejected` case to",
    "    be refused.",
    "",
    "Weights are the planner's five public field names. `wg`/`wv`/`wf`/`wr`/`wc`",
    "are the engine's own keys: the API returns them and refuses them as input."
  ],
  "accepted": [
    {
      "name": "page scope with no crop or period (history scope)",
      "inputs": {
        "filters": { "benchmark": "national_crop_median" },
        "baseline_weights": {
          "gap": 0.3,
          "vulnerability": 0.2,
          "affected_scale": 0.2,
          "readiness": 0.2,
          "cost": 0.1
        },
        "scenario_weights": {
          "gap": 0.5,
          "vulnerability": 0.15,
          "affected_scale": 0.15,
          "readiness": 0.15,
          "cost": 0.05
        },
        "scenario_period": "",
        "top_n": 10
      },
      "request": {
        "baseline": {
          "weights": {
            "gap": 0.3,
            "vulnerability": 0.2,
            "affected_scale": 0.2,
            "readiness": 0.2,
            "cost": 0.1
          },
          "period_code": null,
          "benchmark_strategy": "national_crop_median",
          "province": null,
          "district": null,
          "crop": null,
          "top_n": 10
        },
        "scenario": {
          "weights": {
            "gap": 0.5,
            "vulnerability": 0.15,
            "affected_scale": 0.15,
            "readiness": 0.15,
            "cost": 0.05
          },
          "period_code": null,
          "benchmark_strategy": "national_crop_median",
          "province": null,
          "district": null,
          "crop": null,
          "top_n": 10
        }
      }
    },
    {
      "name": "crop and one published period",
      "inputs": {
        "filters": { "period": "2026B", "crop": "Maize", "benchmark": "national_crop_median" },
        "baseline_weights": {
          "gap": 0.3,
          "vulnerability": 0.2,
          "affected_scale": 0.2,
          "readiness": 0.2,
          "cost": 0.1
        },
        "scenario_weights": {
          "gap": 0.5,
          "vulnerability": 0.15,
          "affected_scale": 0.15,
          "readiness": 0.15,
          "cost": 0.05
        },
        "scenario_period": "",
        "top_n": 25
      },
      "request": {
        "baseline": {
          "weights": {
            "gap": 0.3,
            "vulnerability": 0.2,
            "affected_scale": 0.2,
            "readiness": 0.2,
            "cost": 0.1
          },
          "period_code": "2026B",
          "benchmark_strategy": "national_crop_median",
          "province": null,
          "district": null,
          "crop": "Maize",
          "top_n": 25
        },
        "scenario": {
          "weights": {
            "gap": 0.5,
            "vulnerability": 0.15,
            "affected_scale": 0.15,
            "readiness": 0.15,
            "cost": 0.05
          },
          "period_code": "2026B",
          "benchmark_strategy": "national_crop_median",
          "province": null,
          "district": null,
          "crop": "Maize",
          "top_n": 25
        }
      }
